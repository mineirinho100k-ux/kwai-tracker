# ══════════════════════════════════════════════
#   KWAI TRACKER - Configuração
#   Copie este arquivo para .env e preencha
# ══════════════════════════════════════════════

# ─── OBRIGATÓRIO ──────────────────────────────
# Seu Pixel ID do Kwai (encontra no painel do Kwai Ads → Pixels)
KWAI_PIXEL_ID=seu_pixel_id_aqui

# Access Token da API de Conversões do Kwai
# Painel Kwai Ads → Ferramentas → Conversões API → Gerar Token
KWAI_ACCESS_TOKEN=seu_access_token_aqui

# ─── OPCIONAL ─────────────────────────────────
# Código de teste (Kwai Ads → Pixels → Eventos de Teste)
# Deixe vazio em produção
KWAI_TEST_EVENT=

# Porta do servidor (Railway/Render já definem automaticamente)
PORT=3000

# Chave secreta do webhook VEGA (se VEGA fornecer)
VEGA_SECRET=
